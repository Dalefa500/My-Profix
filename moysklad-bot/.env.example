# Токен бота, выданный @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# API-токен МойСклад: Настройки аккаунта -> Обмен данными -> API -> Токены доступа
MOYSKLAD_TOKEN=your_moysklad_api_token

# Telegram ID владельца(ев) через запятую.
# Узнать свой ID можно у бота @userinfobot
OWNER_IDS=111111111

# Telegram ID директора(ов) через запятую.
# Владелец и директор видят полный отчёт — доход, расход, остаток кассы,
# остатки на складе и задолженность контрагентов.
DIRECTOR_IDS=222222222

# Telegram ID сотрудников через запятую (не обязательно, можно оставить пустым).
# Сотрудники (если есть) видят ТОЛЬКО остаток кассы (без цифр по доходу/расходу).
EMPLOYEE_IDS=

# Во сколько (по времени сервера) каждый день присылать владельцу и
# директору полный отчёт (доход/расход/остаток). Формат ЧЧ:ММ. По
# умолчанию 20:00.
DAILY_REPORT_TIME=20:00

# ── Приложение Profix для iPhone (веб-приложение) ────────────────────

# Адрес, по которому открывается приложение. На этот домен должна быть
# заведена A-запись, указывающая на IP сервера. Caddy сам получит для
# него бесплатный SSL-сертификат.
APP_DOMAIN=app.powermix.ru

# Код доступа в приложение. Придумайте свой, минимум 6 цифр — адрес
# открыт всему интернету, короткий код подбирается быстрее.
WEB_PIN=123456

# Длинная случайная строка для подписи сессий: её знает только сервер.
# Сгенерировать: openssl rand -hex 32
# Если поменять — все, кто вошёл, попросят код заново.
WEB_SECRET=замените_на_случайную_строку

# Порог «на исходе» для позиций в килограммах. Когда остаток падает ниже,
# в «Остатках» загорается индикатор. По умолчанию 1000 кг (1 тонна).
LOW_STOCK_KG=1000

# ── Бот Instagram Direct (аккаунт profix_dushanbe) ───────────────────

# Домен бота. A-запись должна указывать на IP этого сервера.
BOT_DOMAIN=bot.profix.tj

# Строка, которую вы сами придумываете и вписываете в двух местах: сюда и
# в поле «Verify token» при подключении вебхука в консоли Meta. Нужна
# ровно один раз — чтобы Meta убедилась, что адрес ваш.
IG_VERIFY_TOKEN=придумайте_любую_строку

# App Secret из консоли Meta: Настройки приложения → Основные.
# Им подписывается каждый запрос от Meta — без него вебхук открыт всем.
IG_APP_SECRET=your_meta_app_secret

# Долгоживущий токен доступа с правами на переписку.
IG_ACCESS_TOKEN=your_instagram_access_token

# Заполняйте ТОЛЬКО если подключались через Facebook Login — тогда сюда
# ID страницы, а IG_GRAPH_BASE меняйте на https://graph.facebook.com
# При входе через Instagram Login оставьте пустым.
IG_PAGE_ID=
IG_GRAPH_BASE=https://graph.instagram.com
IG_API_VERSION=v23.0

# Ключ Anthropic — бот будет отвечать живым текстом. Без ключа работает
# на правилах по ключевым словам: беднее, но бесплатно.
ANTHROPIC_API_KEY=
IG_MODEL=claude-opus-5

# Телефон менеджера — бот называет его, когда спрашивают цену.
IG_HANDOFF_PHONE=

# Кому дублировать заявки из директа в Telegram. Пусто — возьмёт OWNER_IDS.
IG_NOTIFY_IDS=
