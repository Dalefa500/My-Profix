# Caddy сам получает и продлевает бесплатный SSL-сертификат
# для домена из APP_DOMAIN — настраивать сертификаты вручную не нужно.
# В APP_DOMAIN можно перечислить несколько адресов через пробел: и
# домен с www, и старый адрес на время переезда.

{$APP_DOMAIN} {
	encode gzip
	reverse_proxy web:8000
}
